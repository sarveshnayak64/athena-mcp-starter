{
  "name": "athena-earthquake-explorer",
  "version": "1.0.0",
  "description": "Live USGS earthquake explorer exposed over MCP with an embedded interactive Athena widget",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "smoke": "node scripts/smoke.mjs",
    "build:land": "node scripts/build-land.mjs",
    "inspect": "npx @modelcontextprotocol/inspector@latest --server-url http://localhost:8787/mcp --transport http"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  }
}
